    "@keystatic/core": "^0.6.9",
    "astro": "^7.4.4",
    "js-yaml": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/js-yaml": "^4.0.9",
    "node-html-parser": "^9.0.6",
    "pagefind": "^1.6.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
