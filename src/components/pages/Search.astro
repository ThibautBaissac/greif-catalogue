---
import type { Lang } from "~/lib/edtf";
import { getUi } from "~/lib/i18n";
import StdPage from "./StdPage.astro";

type Props = { lang: Lang };
const { lang } = Astro.props;
const ui = await getUi(lang);
---
<StdPage key="search" active="search" eyebrow={ui.siteSub} {lang} {ui}>
  <form class="search-form" role="search" onsubmit="return false">
    <label class="sr" for="sq">{ui.nav.search}</label>
    <input id="sq" type="search" placeholder={ui.searchPlaceholder} autocomplete="off" />
    <p class="count" id="sq-count" aria-live="polite"></p>
  </form>
  <ol
    class="results"
    id="sq-results"
    data-hint-one={ui.searchHint.one}
    data-hint-other={ui.searchHint.other}
    data-none={ui.searchNone}
    data-unavailable={ui.searchUnavailable}
  >
  </ol>
  <script>
    import "../../scripts/search.ts";
  </script>
</StdPage>
